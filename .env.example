# PostgreSQL database used for durable query state and worker leases.
UBAS_DATABASE_URL=postgresql://ubas:change-me@127.0.0.1:5432/ubas

# Docker Compose creates PostgreSQL and builds its internal URL from these values.
# UBAS_DATABASE_URL above is used by local uv commands, not by Compose services.
# Set a nonempty password before running docker compose up --build -d.
POSTGRES_DB=ubas
POSTGRES_USER=ubas
POSTGRES_PASSWORD=ubas
UBAS_HTTP_PORT=8000

# Browser frontend origins, comma-separated. Empty disables cross-origin access.
UBAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite catalog with flight topology and city profiles. Required by a worker.
UBAS_CATALOG_PATH=./var/catalog.sqlite3

# Factory returning an implementation of FlightProvider.
# Format: package.module:factory
UBAS_FLIGHT_PROVIDER_FACTORY=your_provider.module:create_flight_provider

# Opt-in end-to-end demo: synthetic fares, MOW -> ALA -> TYO, one passenger, RUB.
# UBAS_FLIGHT_PROVIDER_FACTORY=ubas_backend.routing.demo:create_flight_provider
# COMPOSE_PROFILES=worker

# API and worker are separate processes by default. Set true only for local use.
UBAS_EMBEDDED_WORKER=false
UBAS_WORKER_CONCURRENCY=2
UBAS_WORKER_POLL_INTERVAL=1
UBAS_WORKER_LEASE_SECONDS=90
UBAS_WORKER_RETRY_SECONDS=5
UBAS_WORKER_MAX_ATTEMPTS=3
UBAS_WORKER_TIMEOUT_SECONDS=300

# Optional JSON file shared by API and workers; defaults support RUB only.
# With Compose, put this file in ./var, e.g. ./var/planner.json.
# UBAS_PLANNER_CONFIG_PATH=./config/planner.json
