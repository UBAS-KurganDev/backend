# PostgreSQL database used for durable query state and worker leases.
UBAS_DATABASE_URL=postgresql://ubas:change-me@127.0.0.1:5432/ubas

# SQLite catalog with flight topology and city profiles. Required by a worker.
UBAS_CATALOG_PATH=./var/catalog.sqlite3

# Factory returning an implementation of FlightProvider.
# Format: package.module:factory
UBAS_FLIGHT_PROVIDER_FACTORY=your_provider.module:create_flight_provider

# API and worker are separate processes by default. Set true only for local use.
UBAS_EMBEDDED_WORKER=false
UBAS_WORKER_CONCURRENCY=2
UBAS_WORKER_POLL_INTERVAL=1
UBAS_WORKER_LEASE_SECONDS=90
UBAS_WORKER_RETRY_SECONDS=5
UBAS_WORKER_MAX_ATTEMPTS=3
