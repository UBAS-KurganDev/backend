[Unit]
Description=Deploy the latest UBAS master image
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=ubas
Group=ubas
ExecStart=/opt/ubas/poll-production.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/ubas
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027
